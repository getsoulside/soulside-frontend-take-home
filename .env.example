# ---------------------------------------------------------------------------
# Copy this file to `.env`.
# Only ONE value below needs filling in: an LLM provider key.
# `.env` is gitignored — please don't commit real keys.
# ---------------------------------------------------------------------------


# --- FILL THIS IN: your LLM provider. Pick one, leave the others blank. -----
# All three have genuine free tiers with no credit card. More detail, including
# the rate limits you should expect, is in ASSIGNMENT.md.
#
#   Google AI Studio (Gemini)   https://aistudio.google.com/apikey
#   Groq                        https://console.groq.com/keys
#   OpenRouter                  https://openrouter.ai/keys

VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_OPENROUTER_API_KEY=


# --- Already set up. Nothing to do below this line. -------------------------

# Bearer token the mock API expects on every request. Not a secret — it stands
# in for real auth so that there's a header to get right. The server falls back
# to this exact value, so things work even with no `.env` at all. Change it if
# you want; the server reads this same variable.
VITE_API_TOKEN=local-dev-token

# Base URL of the mock API. The Vite dev server also proxies `/api` to it, so
# `fetch('/api/records')` works without this if you'd prefer.
VITE_API_BASE_URL=http://localhost:8787

# One heads-up: anything with a VITE_ prefix is inlined into the client bundle,
# your LLM key included. That's acceptable for this exercise — please don't
# build a proxy server to work around it. It is a reasonable thing to have an
# opinion about, though.
